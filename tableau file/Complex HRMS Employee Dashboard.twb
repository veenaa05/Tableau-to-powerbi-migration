      <aliases enabled='yes' />
      <column caption='AD Email' datatype='string' name='[ADEmail]' role='dimension' type='nominal' />
      <column caption='Business Unit' datatype='string' name='[BusinessUnit]' role='dimension' type='nominal' />
      <column caption='Name' datatype='string' name='[Calculation_361976851708067840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName]+&quot; &quot;+[LastName]' />
      </column>
      <column caption='Active emp' datatype='integer' name='[Calculation_996702923888058384]' role='measure' type='quantitative'>
