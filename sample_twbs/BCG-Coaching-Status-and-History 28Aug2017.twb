      <column caption='Breakdown 2' datatype='string' name='[Breakdown (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Dimension (copy)]=&apos;Program Type&apos; THEN [Calculation_573927482686312448]&#13;&#10;ELSEIF [Parameters].[Dimension (copy)]=&apos;Status&apos; THEN [CoachingStatus]&#13;&#10;ELSEIF [Parameters].[Dimension (copy)]=&apos;Year&apos; THEN STR(YEAR([Calculation_850054452825214976]))&#13;&#10;ELSEIF [Parameters].[Dimension (copy)] =&apos;Location&apos; THEN [Calculation_630503969972051968]&#13;&#10;ELSEIF [Parameters].[Dimension (copy)] =&apos;Date&apos; THEN STR(DATE([Calculation_850054452825214976]))&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter]=&apos;Region&apos; THEN AdminRegion&#13;&#10;END' />
      </column>
      <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[CEn_Key]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
