      <column caption='Date of Interest' datatype='string' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_1051309061222449152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_573927482686312448]= &quot;Executive&quot; then (&quot;Engagement Expiration&quot; + &quot; &quot; + str(DATE([APPPartExpiration])))&#13;&#10;ELSE(&quot;Program Start Date&quot; + &quot; &quot; + STR([Calculation_237846378443587584]))&#13;&#10;END' />
      </column>
      <column caption='Next Scheduled Session' datatype='string' name='[Calculation_1051309061226000385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull(str([NextScheduledSession]),&quot;No Session Scheduled&quot;)' />
      </column>
      <column caption='Program Date' datatype='date' datatype-customized='true' default-format='*mm &apos;yy' name='[Calculation_1171780372031787008]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([EventStartDate])' />
      </column>
      <column caption='Total Hours Allotted' datatype='real' name='[Calculation_1171780372081389569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[HoursAllotted]+[HoursAdjusted]' />
      </column>
      <column caption='DataAsOf' datatype='string' name='[Calculation_1396678839152631808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Data as of:&quot;' />
      </column>
      <column caption='Not-Complete-Coaching' datatype='string' name='[Calculation_197876915990441984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[CoachingStatus]' />
      </column>
      <column caption='Event Start' datatype='date' name='[Calculation_237846378443587584]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Date([EventStartDate])' />
      </column>
      <column caption='Hours Remaining' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_536772781885001728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[HoursAdjusted]+[HoursAllotted] - [HoursUsed]' />
      </column>
      <column caption='Program Type' datatype='string' name='[Calculation_573927482686312448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([EventCode],3)&#13;&#10;WHEN &apos;EXC&apos; THEN &apos;Executive&apos;&#13;&#10;WHEN &apos;ICC&apos; THEN &apos;Follow-on&apos;&#13;&#10;WHEN &apos;FDB&apos; THEN &apos;Feedback&apos;&#13;&#10;ELSE &apos;Other&apos; END' />
      </column>
      <column caption='Participants' datatype='integer' name='[Calculation_573927482687131649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ESI_Key])' />
      </column>
      <column caption='Breakdown' datatype='string' name='[Calculation_573927482715074562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[IM_First_Name Parameter]=&apos;Program Type&apos; THEN [Calculation_573927482686312448]&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter]=&apos;Status&apos; THEN [CoachingStatus]&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter]=&apos;Year&apos; THEN STR(YEAR([Calculation_850054452825214976]))&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter] =&apos;Location&apos; THEN [Calculation_630503969972051968]&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter] =&apos;Date&apos; THEN STR(DATE([Calculation_850054452825214976]))&#13;&#10;ELSEIF [Parameters].[IM_First_Name Parameter]=&apos;Region&apos; THEN [AdminRegion]&#13;&#10;END' />
      </column>
      <column caption='Avg Additional Hours' datatype='real' name='[Calculation_573927482719961091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([HoursAdjusted])/[Calculation_573927482687131649]' />
      </column>
      <column caption='Avg Used' datatype='real' name='[Calculation_573927482722492420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([HoursUsed])/[Calculation_573927482687131649]' />
      </column>
      <column caption='Avg Allotted' datatype='real' name='[Calculation_573927482722770949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([HoursAllotted])/[Calculation_573927482687131649]' />
      </column>
      <column caption='Pgm or Exec Location' datatype='string' name='[Calculation_630503969972051968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[CountryName]' />
      </column>
      <column caption='Position' datatype='integer' name='[Calculation_630503970067148801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Min(60)' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_631066916082978816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_573927482686312448]&#13;&#10;WHEN &apos;Executive&apos; THEN&#13;&#10;  IF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&lt;=34 &#13;&#10;    or ISNULL([LastSessionDate]) THEN &apos;On Track&apos;&#13;&#10;  ELSEIF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&lt;=44&#13;&#10;   THEN &apos;Behind&apos;&#13;&#10;  ELSEIF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&gt;44&#13;&#10;   THEN &apos;Overdue&apos;&#13;&#10;  END&#13;&#10;&#13;&#10;WHEN &apos;Follow-on&apos; THEN&#13;&#10;    IF [NextScheduledSession]&gt;TODAY() THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 3 THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 6 THEN &apos;Behind&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&gt;= 6 THEN &apos;Overdue&apos;&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &apos;Feedback&apos; THEN &#13;&#10;    IF [NextScheduledSession]&gt;TODAY() THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 3 THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 6 THEN &apos;Behind&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&gt;= 6 THEN &apos;Overdue&apos;&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &apos;Other&apos; THEN &apos;Unknown&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='% Remaining Hours' datatype='real' default-format='p0%' name='[Calculation_631066917354291201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_536772781885001728])/SUM([HoursAllotted])' />
      </column>
      <column caption='Engagement Expiration' datatype='date' name='[Calculation_850054452825214976]' role='dimension' type='ordinal'>
