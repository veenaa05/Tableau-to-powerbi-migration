              <calculation class='tableau' formula='CASE [Calculation_573927482686312448]&#13;&#10;WHEN &apos;Executive&apos; THEN&#13;&#10;  IF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&lt;=34 &#13;&#10;    or ISNULL([LastSessionDate]) THEN &apos;On Track&apos;&#13;&#10;  ELSEIF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&lt;=44&#13;&#10;   THEN &apos;Behind&apos;&#13;&#10;  ELSEIF DATEDIFF(&apos;day&apos;,[LastSessionDate],TODAY())&gt;44&#13;&#10;   THEN &apos;Overdue&apos;&#13;&#10;  END&#13;&#10;&#13;&#10;WHEN &apos;Follow-on&apos; THEN&#13;&#10;    IF [NextScheduledSession]&gt;TODAY() THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 3 THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 6 THEN &apos;Behind&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&gt;= 6 THEN &apos;Overdue&apos;&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &apos;Feedback&apos; THEN &#13;&#10;    IF [NextScheduledSession]&gt;TODAY() THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 3 THEN &apos;On Track&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&lt; 6 THEN &apos;Behind&apos;&#13;&#10;    ELSEIF DATEDIFF(&apos;month&apos;,[Calculation_850054452825214976],TODAY())&gt;= 6 THEN &apos;Overdue&apos;&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &apos;Other&apos; THEN &apos;Unknown&apos;&#13;&#10;&#13;&#10;END' />
            </column>
