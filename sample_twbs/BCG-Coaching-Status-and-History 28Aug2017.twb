            <column caption='Hours Remaining' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_536772781885001728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[HoursAdjusted]+[HoursAllotted] - [HoursUsed]' />
            </column>
            <column caption='Program Type' datatype='string' name='[Calculation_573927482686312448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LEFT([EventCode],3)&#13;&#10;WHEN &apos;EXC&apos; THEN &apos;Executive&apos;&#13;&#10;WHEN &apos;ICC&apos; THEN &apos;Follow-on&apos;&#13;&#10;WHEN &apos;FDB&apos; THEN &apos;Feedback&apos;&#13;&#10;ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Pgm or Exec Location' datatype='string' name='[Calculation_630503969972051968]' role='dimension' type='nominal'>
