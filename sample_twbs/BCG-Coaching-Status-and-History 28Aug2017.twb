            <column caption='Date of Interest' datatype='string' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_1051309061222449152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_573927482686312448]= &quot;Executive&quot; then (&quot;Engagement Expiration&quot; + &quot; &quot; + str(DATE([APPPartExpiration])))&#13;&#10;ELSE(&quot;Program Start Date&quot; + &quot; &quot; + STR([Calculation_237846378443587584]))&#13;&#10;END' />
            </column>
            <column caption='Next Scheduled Session' datatype='string' name='[Calculation_1051309061226000385]' role='dimension' type='nominal'>
